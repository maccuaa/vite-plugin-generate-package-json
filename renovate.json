{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": ["config:best-practices", "security:minimumReleaseAgeNpm", ":automergeAll", ":widenPeerDependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Security PRs corrupt complex peerDependencies ranges (each `||` alternative becomes the fix version, space-joined). Leave peer ranges alone there; regular widening is unaffected.",
      "matchDepTypes": ["peerDependencies"],
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "enabled": false
    }
  ]
}
